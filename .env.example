# Copy to .env (gitignored). Real environment variables always override this file.

# Target. Public shared demo (default) or a self-hosted instance (see docker-compose.yml).
BASE_URL=https://parabank.parasoft.com/parabank/
# BASE_URL=http://localhost:8080/parabank/

# Reproducible test data: faker is re-seeded per test from TEST_SEED + test id.
# Leave empty for a random seed (printed in each test's "seed" annotation).
TEST_SEED=

# Parallelism / retries. Defaults: public site 1 worker, self-hosted 4; retries 0 locally, 1 on CI.
WORKERS=
RETRIES=

# Comma-separated browsers for the functional projects: chromium,firefox,webkit
BROWSERS=chromium

# Cloudflare protection (public site only; all default to 0/off for a self-hosted BASE_URL).
# Leaky bucket + 60 s window: average requests per minute that reach the network.
RATE_LIMIT_RPM=60
# Headroom (requests) each test waits for before it starts. Measured test cost: 2-16 requests (p90 ~16).
RATE_LIMIT_TEST_BUDGET=20
# Long-window cap (hypothesis, unverified): max requests per window, aimed at slow cumulative trips.
RATE_LIMIT_LONG_WINDOW_S=600
RATE_LIMIT_LONG_MAX=450
# Longest 429 Retry-After / challenge cool-down worth waiting out before failing fast
# (RATE_LIMITED / CF_CHALLENGE). Use 330 for unattended jobs (bans run ~180-300 s).
RATE_LIMIT_MAX_WAIT_S=60
# A Cloudflare managed challenge (403 cf-mitigated: challenge) is replayed once after this delay.
CF_CHALLENGE_RETRY_DELAY_S=30
# After a challenge/block survives the replay, no traffic is sent for this long.
CF_CHALLENGE_COOLDOWN_S=120
# Persisted pacing/ban state (survives worker restarts and consecutive runs). Default:
# .cache/rate-limit-<host>.json
RATE_LIMIT_STATE_FILE=

# Abort image/font/media requests (cuts ~75% of traffic). Set false for visual work.
BLOCK_STATIC_ASSETS=true
# Serve same-origin CSS/JS from a per-worker memory cache after the first fetch.
CACHE_STATIC_ASSETS=true

# Whole-run guard in minutes (default 20 local / 30 CI).
GLOBAL_TIMEOUT_MIN=

HEADED=false
